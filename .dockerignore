# Keep the build context small: everything here is either regenerated inside
# the image or bind-mounted from the host at runtime (see docker-compose.yml),
# so copying it in only inflates every image layer.

# Virtualenvs — note BOTH spellings; ".venv/" was missing and a local one adds
# well over a gigabyte to the context.
venv/
.venv/
ENV/
env/

# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local database — production uses postgres
db.sqlite3
db.sqlite3.bak
*.sqlite3

# Regenerated by collectstatic on container start
staticfiles/

# Bind-mounted from the host at runtime, not needed in the image
media/
data/faiss_index/

# Secrets — compose reads .env from the host via env_file
.env
.env.*
!.env.example

# VCS, tooling and local scratch
.git/
.github/
.idea/
.vscode/
.impeccable/
.claude/
certs/
node_modules/
*.log
